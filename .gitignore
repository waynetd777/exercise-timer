node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.vite/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example

# Local tooling scratch, not part of the project.
.gastown-ignore
__pycache__/

# Screenshot sources. The README serves the .webp beside them, converted with
# `cwebp -resize 900 0 -q 80 -m 6 shot.png -o shot.webp`. The PNGs are ~1-2MB
# each and would only ever be duplicates in the history.
docs/screenshots/*.png

# CLAUDE.md, AGENTS.md and the two hook files carry sift's stanza and hook
# wiring, and are tracked so a fresh clone gets them. Per-machine slash
# commands and local settings are not.
.claude/*
!.claude/settings.json
.codex/*
!.codex/hooks.json
.opencode/

# sift: derived state and private notes
_sift/.cache/
_sift/local/
